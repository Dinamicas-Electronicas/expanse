{
  "name": "PostgreSQL HA (Patroni)",
  "description": "High Availability PostgreSQL cluster with Patroni, etcd, HAProxy load balancer, and PgBouncer connection pooling",
  "category": "Database",
  "logo": "postgresql",
  "image": "postgres:16-alpine",
  "isStack": true,
  "haEnabled": true,
  "default_ports": ["5432:5432", "6432:6432", "8080:8080"],
  "env_vars": {
    "POSTGRES_PASSWORD": "postgres",
    "POSTGRES_USER": "postgres",
    "POSTGRES_DB": "expanse",
    "PATRONI_SCOPE": "expanse-cluster",
    "PATRONI_ETCD_HOSTS": "etcd:2379"
  },
  "volumes": ["pg-primary-data:/var/lib/postgresql/data"],
  "databaseHA": {
    "replication": {
      "enabled": true,
      "mode": "async",
      "primaryRegion": "primary",
      "replicas": [
        { "region": "replica-1", "role": "sync", "priority": 100 },
        { "region": "replica-2", "role": "async", "priority": 50 }
      ]
    },
    "failover": {
      "enabled": true,
      "timeout": 30,
      "maxRetries": 3,
      "healthCheckInterval": 10,
      "promotionPolicy": "priority"
    },
    "connectionPool": {
      "enabled": true,
      "type": "pgbouncer",
      "mode": "transaction",
      "poolSize": 25,
      "maxConnections": 1000,
      "idleTimeout": 600
    },
    "loadBalancer": {
      "enabled": true,
      "type": "haproxy",
      "algorithm": "round-robin",
      "healthCheckPath": "/health",
      "stickySessions": false,
      "port": 5432,
      "targetPort": 5432
    },
    "backup": {
      "enabled": true,
      "schedule": "0 2 * * *",
      "retentionDays": 7,
      "storage": "local",
      "encryption": true,
      "pointInTimeRecovery": true
    }
  },
  "related_services": [
    {
      "name": "db-primary",
      "image": "postgres:16-alpine",
      "env_vars": {
        "POSTGRES_PASSWORD": "postgres",
        "POSTGRES_USER": "postgres",
        "POSTGRES_DB": "expanse",
        "PATRONI_SCOPE": "expanse-cluster",
        "PATRONI_ETCD_HOSTS": "etcd:2379",
        "PATRONI_NAME": "db-primary"
      },
      "volumes": ["pg-primary-data:/var/lib/postgresql/data"],
      "healthcheck": {
        "test": ["CMD-SHELL", "patronictl -c /etc/patroni/patroni.yml list"],
        "interval": "10s",
        "timeout": "5s",
        "retries": 5,
        "start_period": "30s"
      }
    },
    {
      "name": "db-replica",
      "image": "postgres:16-alpine",
      "env_vars": {
        "POSTGRES_PASSWORD": "postgres",
        "POSTGRES_USER": "postgres",
        "POSTGRES_DB": "expanse",
        "PATRONI_SCOPE": "expanse-cluster",
        "PATRONI_ETCD_HOSTS": "etcd:2379",
        "PATRONI_NAME": "db-replica"
      },
      "volumes": ["pg-replica-data:/var/lib/postgresql/data"],
      "deploy": {
        "replicas": 2
      },
      "healthcheck": {
        "test": ["CMD-SHELL", "patronictl -c /etc/patroni/patroni.yml list"],
        "interval": "10s",
        "timeout": "5s",
        "retries": 5,
        "start_period": "30s"
      }
    },
    {
      "name": "etcd",
      "image": "bitnami/etcd:3.5",
      "env_vars": {
        "ETCD_ADVERTISE_CLIENT_URLS": "http://etcd:2379",
        "ETCD_LISTEN_CLIENT_URLS": "http://0.0.0.0:2379",
        "ETCD_NAME": "etcd"
      },
      "volumes": ["etcd-data:/bitnami/etcd"],
      "ports": ["2379:2379", "2380:2380"],
      "healthcheck": {
        "test": ["CMD", "etcdctl", "endpoint", "health"],
        "interval": "10s",
        "timeout": "5s",
        "retries": 5
      }
    },
    {
      "name": "pgbouncer",
      "image": "edoburu/pgbouncer:latest",
      "env_vars": {
        "DATABASES": "expanse=host=haproxy port=5432 dbname=expanse",
        "POOL_MODE": "transaction",
        "MAX_CLIENT_CONN": "1000",
        "DEFAULT_POOL_SIZE": "25",
        "MIN_POOL_SIZE": "5",
        "RESERVE_POOL_SIZE": "5"
      },
      "ports": ["6432:6432"],
      "depends_on": {
        "haproxy": { "condition": "service_healthy" }
      }
    },
    {
      "name": "haproxy",
      "image": "haproxy:2.9-alpine",
      "ports": ["5432:5432", "8404:8404"],
      "volumes": ["haproxy.conf:/usr/local/etc/haproxy/haproxy.cfg:ro"],
      "healthcheck": {
        "test": ["CMD", "haproxy", "-c", "-f", "/usr/local/etc/haproxy/haproxy.cfg"],
        "interval": "10s",
        "timeout": "5s",
        "retries": 3
      }
    }
  ]
}