# Copy to .env and run `pnpm generate-secrets` to fill secret values.
APP_URL=http://localhost:4000
URL=http://localhost:4000
CORE_ONLY=true
DISABLE_TELEMETRY=true
DISABLE_SIGNUP=false
# Allow sensitive host mounts (Docker socket, /etc, ...) in deployed stacks.
# Keep false unless you are the only operator of the host.
ALLOW_COMPOSE_HOST_ACCESS=false
# Allow `build:` contexts in deployed stacks.
ALLOW_COMPOSE_BUILD=false
# Allow administrators to manage non-Expanse projects/containers on the host.
ALLOW_HOST_PROJECT_OPS=false
# Set to false when the app is exposed directly (no reverse proxy).
TRUST_PROXY=true
# Opt-in load of the third-party opentech-ux script.
ENABLE_EXTERNAL_TELEMETRY=false
# Share links expire after N days (0 = never).
SHARE_TTL_DAYS=30
# Retention for generated PNG exports and /tmp compose work dirs.
EXPORT_RETENTION_DAYS=7
TMP_RETENTION_DAYS=7
# Per-installation quotas and resource limits.
MAX_COMPOSES_PER_USER=50
MAX_SERVICES_PER_COMPOSE=50
APP_CPUS=2.0
APP_MEM_LIMIT=2g
DB_CPUS=1.0
DB_MEM_LIMIT=1g
DB_USER=expanse
DB_PASS=replace-with-a-generated-password
SECRET_KEY=replace-with-a-generated-secret
