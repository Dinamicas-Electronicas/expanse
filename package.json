{
  "name": "next-expanse",
  "version": "1.1.5",
  "private": true,
  "description": "Expanse — IDE visual para diseñar, desplegar y monitorear Docker Compose.",
  "author": "Dinámicas Electrónicas <dinamicas.electronicas@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/Dinamicas-Electronicas/expanse",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dinamicas-Electronicas/expanse.git"
  },
  "bugs": {
    "url": "https://github.com/Dinamicas-Electronicas/expanse/issues"
  },
  "keywords": [
    "docker",
    "docker-compose",
    "nextjs",
    "visual-editor",
    "devops",
    "self-hosted"
  ],
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "start": "next start",
    "lint": "eslint .",
    "sync-icons": "node scripts/sync-icons.mjs",
    "sanitize-library": "node scripts/sanitize-library.mjs",
    "migrate:emails": "node scripts/normalize-emails.mjs",
    "license:headers": "node scripts/add-license-header.mjs",
    "license:check": "node scripts/add-license-header.mjs --check",
    "generate-secrets": "node scripts/generate-secrets.mjs",
    "test": "vitest run",
    "test:docker": "RUN_DOCKER_SMOKE=true vitest run tests/integration/dockerTemplates.integration.test.ts",
    "test:docker:all": "RUN_DOCKER_ALL=true vitest run tests/integration/dockerTemplates.integration.test.ts",
    "test:watch": "vitest",
    "audit": "pnpm audit --audit-level=high",
    "smoke": "bash scripts/smoke-test.sh"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toggle": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/react-table": "^8.21.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.12.1",
    "axios": "^1.21.1",
    "bcryptjs": "^3.0.3",
    "bson": "^6.10.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "elkjs": "^0.12.1",
    "expanse-docker-lib": "^1.0.2",
    "html-to-image": "^1.11.13",
    "jose": "^6.2.18",
    "lucide-react": "^0.451.0",
    "mongodb": "^6.22.0",
    "next": "15.5.29",
    "next-intl": "^4.15.3",
    "posthog-js": "^1.453.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.92.0",
    "react-hot-toast": "^2.6.1",
    "tailwind-merge": "^2.6.2",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^11.1.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7",
    "zod-form-data": "^3.0.4",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "^15.5.29",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.33",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
